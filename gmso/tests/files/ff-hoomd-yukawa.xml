<?xml version="1.0" encoding="UTF-8"?>
<!--
  Buckingham beads in the spelling homod.md.pair.Yukawa uses. Buckingham parameters are  not combined, so the _A-_B pair is stated explicitly.
-->
<ForceField version="0.0.1" name="HOOMDYukawa">
  <FFMetaData combiningRule="lorentz">
    <Units energy="kJ/mol" distance="nm" mass="amu" charge="coulomb"/>
  </FFMetaData>

  <AtomTypes expression="epsilon*(exp(-kappa*r)/r)">
    <ParametersUnitDef parameter="epsilon" unit="nm*kJ/mol"/>
    <ParametersUnitDef parameter="kappa" unit="nm**-1"/>
    <AtomType name="_A" element="_A" atomclass="_A" mass="1.0" charge="0.0" definition="_A" description="Yukawa bead A">
      <Parameters>
        <Parameter name="epsilon" value="100.0"/>
        <Parameter name="kappa" value="0.030"/>
      </Parameters>
    </AtomType>
    <AtomType name="_B" element="_B" atomclass="_B" mass="1.0" charge="0.0" definition="_B" description="Yukawa bead B">
      <Parameters>
        <Parameter name="epsilon" value="200.0"/>
        <Parameter name="kappa" value="0.040"/>
      </Parameters>
    </AtomType>
  </AtomTypes>

  <PairPotentialTypes expression="epsilon*(exp(-kappa*r)/r)">
    <ParametersUnitDef parameter="epsilon" unit="nm*kJ/mol"/>
    <ParametersUnitDef parameter="kappa" unit="nm**-1"/>
    <PairPotentialType name="YukawaPotential" type1="_A" type2="_B">
      <Parameters>
        <Parameter name="epsilon" value="300.0"/>
        <Parameter name="kappa" value="0.050"/>
      </Parameters>
    </PairPotentialType>
  </PairPotentialTypes>
</ForceField>
